{
  "name": "Jekyll DevContainer",
  "dockerFile": "Dockerfile",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspace",
  "forwardPorts": [4000],
  "postCreateCommand": "bundle install",

  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp",
        "rebornix.ruby"
      ]
    }
  }
}
